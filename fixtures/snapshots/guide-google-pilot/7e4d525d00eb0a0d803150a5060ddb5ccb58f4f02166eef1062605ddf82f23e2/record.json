    },
    {
      "type": "heading",
      "level": 2,
      "content": [
        {
          "text": "Det jeg mangler forståelse for:"
        }
      ]
    },
    {
      "type": "list",
      "items": [
        [
          {
            "text": "De faktiske indtægter for 2026. Forslagets 2026-kolonne passer ikke med det antal weekender og døgn, teksten nævner."
          }
        ],
        [
          {
            "text": "Hvordan beløbene til vand og renovation er fordelt mellem fælleslokalerne og resten af bygningen."
          }
        ],
        [
          {
            "text": "Hvor meget varme og el stiger, når lokalerne er booket. Det kan Ista-aflæsninger måned for måned vise."
          }
        ],
        [
          {
            "text": "Hvor mange klubber der stopper ved 100 kr. i timen. Fra 2025 til 2026 stoppede tre."
          }
        ],
        [
          {
            "text": "Hvad \"januar, maj og september\" betyder i rengøringsposten, og hvordan de 10.000 kr. hænger sammen med, at brugerne selv gør rent."
          }
        ],
        [
          {
            "text": "Hvad kontrol, rensning og vedligehold af køkkenet koster, og om det er lovpligtigt. Driftsbudgettet har 50.000 kr. til det, og det kan være mere end hele det beløb, sagen handler om."
          }
        ],
        [
          {
            "text": "Om varmen i fælleslokalerne koster 30.000 kr., som driftsbudgettet viser, eller 35.000 kr., som forslaget regner med."
          }
        ],
        [
          {
            "text": "Om weekendtimeprisen på 150 kr. også gælder klubberne."
          }
        ],
        [
          {
            "text": "Hvorfor billard, badminton og vinklub er fjernet fra tabellen, mens summerne for 2025 og 2026 er uændrede."
          }
        ]
      ]
    }
