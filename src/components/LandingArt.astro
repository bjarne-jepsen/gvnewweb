---
// A line drawing beside the running text on a section's landing pages: the long side of a "sektion 2" house,
// traced from the original elevation by Poul Holsøe and Jesper Tvede (1918). The roof flares out at the
// gables, the chimney has its scalloped flashing, and the bay window sits to the left. Thin green lines on
// paper; it is decoration and hidden from screen readers. Coordinates follow the drawing (1 unit ≈ 0.4 mm on
// the 1:50 sheet), so new details can be measured straight off it. Shapes are filled with paper, so a shape
// drawn later covers the lines behind it.
const G = 1330; // ground
const wall = { l: 108, r: 1445 }, eave = 775;
// The roof: an outer edge with a flared foot at each gable, and an inner edge just inside it.
const outer = 'M 60 408 Q 112 402 132 362 L 250 155 L 1310 152 L 1428 362 Q 1448 402 1490 408';
const inner = 'M 108 412 Q 142 400 154 372 L 268 172 L 1290 172 L 1404 372 Q 1416 400 1440 412';
const roofFace = `${inner} L 1440 ${eave} L 108 ${eave} Z`;
// The tiles run down the roof in vertical strips. Every second line from the drawing keeps it light.
const strips = Array.from({ length: 19 }, (_, i) => 200 + i * 64);
// A window: frame, a mullion down the middle and a transom; the sashes under the transom get one more bar.
const win = (x: number, y: number, w: number, h: number, t = .37) => {
  const mid = x + w / 2, ty = y + h * t, low = ty + (y + h - ty) / 2;
  return { frame: { x, y, width: w, height: h }, bars: `M ${mid} ${y} V ${y + h} M ${x} ${ty} H ${x + w} M ${x} ${low} H ${x + w}` };
};
const windows = [win(722, 850, 188, 260), win(1127, 850, 188, 260)];
// The bay window: four lights between posts, a zinc panel under them and a shallow roof on top.
const bay = { l: 220, r: 578, top: 850, sill: 1110 };
const bayLights = [win(232, 862, 50, 236), win(320, 862, 74, 236), win(410, 862, 74, 236), win(505, 862, 62, 236)];
---
<svg class="landing-art" viewBox="0 0 1540 1350" focusable="false" aria-hidden="true">
  <defs><clipPath id="landing-roof"><path d={roofFace} /></clipPath></defs>
  <!-- Roof -->
  <path class="line" d={outer} />
  <path d={roofFace} />
  <g clip-path="url(#landing-roof)">{strips.map(x => <path d={`M ${x} 150 V ${eave}`} />)}</g>
  <path d={`M 145 412 V ${eave} M 1410 412 V ${eave}`} />
  <rect x="55" y="404" width="108" height="14" /><rect x="1386" y="404" width="108" height="14" />
  <path d="M 100 418 v 18 h 14 v -18 M 1420 418 v 18 h 14 v -18" />
  <!-- Chimney with its cap and the scalloped flashing where it meets the roof -->
  <rect x="566" y="24" width="126" height="16" />
  <path d="M 576 40 V 236 q 14 14 28 0 q 14 14 28 0 q 14 14 28 0 q 14 14 28 0 V 40" />
  <!-- Cornice and wall -->
  <rect x={wall.l} y={eave} width={wall.r - wall.l} height="16" />
  <rect x={wall.l + 37} y={eave + 16} width={wall.r - wall.l - 37} height={G - eave - 16} />
  <path d={`M ${wall.l + 37} 1255 H ${wall.r}`} />
  <!-- Downpipe at the left corner -->
  <path d={`M 116 ${eave + 16} V ${G - 6} M 140 ${eave + 16} V ${G - 6} M 110 ${G} q 18 -12 36 0`} />
  <!-- Bay window -->
  <polygon points={`${bay.l - 14},${bay.top} 300,826 505,826 ${bay.r + 16},${bay.top - 4}`} />
  <rect x={bay.l} y={bay.top} width={bay.r - bay.l} height={G - bay.top} />
  <path d={`M 305 ${bay.top} V ${G} M 497 ${bay.top} V ${G} M ${bay.l} ${bay.sill} H ${bay.r}`} />
  {bayLights.map(w => <><rect {...w.frame} /><path d={w.bars} /></>)}
  <!-- Windows -->
  {windows.map(w => <><rect {...w.frame} /><path d={w.bars} /></>)}
  <!-- Ground -->
  <path d={`M 0 ${G} H 1540`} />
</svg>
