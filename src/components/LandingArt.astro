---
// A line drawing beside the running text on a section's landing page. Thin green lines on paper, in the same
// shapes as the front page drawing (Scene.astro), so the pages belong together without repeating the colours.
// It is decoration and hidden from screen readers. Two variants to compare (choose with LANDING_ART at build):
//   huse  - a cut from the row of houses, the same on every landing page
//   motiv - one motif per section, in the same style
// Shapes are filled with paper, so a shape drawn later covers the lines behind it.
interface Props { section: string }
const { section } = Astro.props;
const variant = (process.env.LANDING_ART ?? 'motiv') === 'huse' ? 'huse' : 'motiv';
const G = 300; // the ground line

// A hedge from a to b with a rounded top: one arc for every 18 px.
const hedge = (a: number, b: number, top = G - 20) => {
  const n = Math.max(1, Math.round((b - a) / 18)), step = (b - a) / n;
  const bumps = Array.from({ length: n }, () => `a ${step / 2} ${step / 2.2} 0 0 1 ${step} 0`).join(' ');
  return `M ${a} ${G} L ${a} ${top} ${bumps} L ${b} ${G}`;
};
// A tree crown as one outline: four bumps over a flat, slightly rounded base, centred on (x, y) with radius r.
const crown = (x: number, y: number, r: number) => {
  const p = (dx: number, dy: number) => `${x + dx * r} ${y + dy * r}`;
  return `M ${p(-1, .3)} A ${r * .5} ${r * .5} 0 0 1 ${p(-.62, -.5)} A ${r * .52} ${r * .52} 0 0 1 ${p(.22, -.88)}` +
    ` A ${r * .5} ${r * .5} 0 0 1 ${p(.92, -.28)} A ${r * .46} ${r * .46} 0 0 1 ${p(.82, .52)} A ${r * 2} ${r * 2} 0 0 1 ${p(-1, .3)} Z`;
};
const tree = (x: number, r: number, h: number) => ({ trunk: `M ${x} ${G} L ${x} ${G - h}`, crown: crown(x, G - h - r * .45, r) });

// Variant 1: three houses from the row, a tree and a hedge with a gate.
const gavl = { x: 36, w: 112, h: 72 }, lang = { x: 184, w: 180, h: 64 };
const gEave = G - gavl.h, gTop = gEave - 68, gMid = gavl.x + gavl.w / 2;
const lEave = G - lang.h, lTop = lEave - 54, lMid = lang.x + lang.w / 2;
const rowTree = tree(424, 40, 58);
const gate = { from: 258, to: 290 };

// Variant 2: the bunting for Socialt hangs on a curve between two trees.
const q = (t: number, a: number, c: number, b: number) => (1 - t) ** 2 * a + 2 * (1 - t) * t * c + t * t * b;
const flags = Array.from({ length: 9 }, (_, i) => (i + 1) / 10).map(t => {
  const x = q(t, 108, 240, 372), y = q(t, 140, 210, 140);
  return `${x - 9},${y - 1} ${x + 9},${y + 1} ${x + 1},${y + 21}`;
});
const leftTree = tree(70, 46, 120), rightTree = tree(410, 42, 120), houseTree = tree(424, 46, 84);
---
<svg class="landing-art" viewBox={variant === 'huse' ? '0 140 480 170' : '0 30 480 280'} focusable="false" aria-hidden="true" data-variant={variant}>
  {variant === 'huse' ? <g>
    <path d={rowTree.trunk} /><path d={rowTree.crown} />
    <rect x={gavl.x + gavl.w * .64} y={gTop + 20} width="12" height="34" />
    <rect x={gavl.x} y={gEave} width={gavl.w} height={gavl.h} />
    <polygon points={`${gavl.x - 6},${gEave} ${gMid},${gTop} ${gavl.x + gavl.w + 6},${gEave}`} />
    <rect x={gMid - 10} y={gEave - 40} width="20" height="22" />
    <rect x={gavl.x + 16} y={gEave + 14} width="24" height="26" /><rect x={gavl.x + gavl.w - 40} y={gEave + 14} width="24" height="26" />
    <rect x={lang.x + lang.w * .72} y={lTop - 16} width="12" height="30" />
    <rect x={lang.x} y={lEave} width={lang.w} height={lang.h} />
    <polygon points={`${lang.x - 8},${lEave} ${lang.x + 34},${lTop} ${lang.x + lang.w - 34},${lTop} ${lang.x + lang.w + 8},${lEave}`} />
    <rect x={lMid - 18} y={lTop + 16} width="36" height="30" /><polygon points={`${lMid - 25},${lTop + 18} ${lMid},${lTop + 2} ${lMid + 25},${lTop + 18}`} />
    <rect x={lMid - 9} y={lTop + 24} width="18" height="16" />
    <rect x={lang.x + 16} y={lEave + 14} width="26" height="26" /><rect x={lang.x + lang.w - 42} y={lEave + 14} width="26" height="26" />
    <rect x={lMid - 12} y={G - 46} width="24" height="46" />
    <path d={hedge(14, gate.from)} /><path d={hedge(gate.to, 466)} />
    <path d="M 10 300 H 470" />
    <path d={`M ${gate.from + 4} ${G} V ${G - 18} H ${gate.to - 4} V ${G} M ${gate.from + 12} ${G - 18} V ${G} M ${gate.to - 12} ${G - 18} V ${G}`} />
  </g>

  : section === 'bo-her' ? <g>
    <!-- Andelshaveren: the front of a house, the hedge to the road, an open gate and the letterbox. -->
    <rect x="300" y="52" width="12" height="44" />
    <rect x="150" y="150" width="300" height="150" />
    <polygon points="140,150 196,74 404,74 460,150" />
    <rect x="276" y="200" width="44" height="100" /><circle cx="310" cy="252" r="2" />
    <rect x="180" y="190" width="54" height="56" /><path d="M 207 190 V 246 M 180 218 H 234" />
    <rect x="362" y="190" width="54" height="56" /><path d="M 389 190 V 246 M 362 218 H 416" />
    <path d={hedge(20, 240, 262)} /><path d={hedge(340, 470, 262)} />
    <path d="M 244 300 V 254 M 336 300 V 254" />
    <path d="M 244 296 L 220 304 V 266 L 244 262" /><path d="M 228 302 V 266 M 236 300 V 264" />
    <path d="M 70 300 V 236" /><rect x="50" y="214" width="40" height="24" /><path d="M 56 222 H 84" />
    <path d="M 10 300 H 470" />
  </g>

  : section === 'foreningen' ? <g>
    <!-- Foreningen: the notice board under a small roof, with the notices pinned to it. -->
    <path d="M 150 300 V 92 M 330 300 V 92" />
    <polygon points="128,96 240,40 352,96" />
    <rect x="140" y="96" width="200" height="140" />
    <rect x="150" y="106" width="180" height="120" />
    <g transform="rotate(-4 196 156)"><rect x="166" y="120" width="60" height="76" /><path d="M 174 136 H 216 M 174 146 H 218 M 174 156 H 210 M 174 166 H 216" /><circle cx="196" cy="124" r="3" /></g>
    <g transform="rotate(3 280 150)"><rect x="248" y="116" width="64" height="48" /><path d="M 256 130 H 302 M 256 140 H 298 M 256 150 H 290" /><circle cx="280" cy="120" r="3" /></g>
    <g transform="rotate(-2 280 196)"><rect x="252" y="176" width="54" height="40" /><path d="M 260 190 H 296 M 260 200 H 290" /><circle cx="279" cy="180" r="3" /></g>
    <path d="M 20 300 H 460" />
  </g>

  : section === 'faellesskab' ? <g>
    <!-- Socialt: a long table under a string of flags between two trees. -->
    <path d={leftTree.trunk} /><path d={leftTree.crown} />
    <path d={rightTree.trunk} /><path d={rightTree.crown} />
    <path class="line" d="M 108 140 Q 240 210 372 140" />
    {flags.map(f => <polygon points={f} />)}
    <path d="M 150 300 V 248 M 330 300 V 248" />
    <rect x="130" y="240" width="220" height="8" />
    <path d="M 118 270 H 362 M 132 270 V 300 M 348 270 V 300" />
    <path d="M 180 240 V 226 H 192 V 240 M 266 240 L 262 222 H 280 L 276 240" />
    <path d="M 20 300 H 460" />
  </g>

  : <g>
    <!-- Om Grøndalsvænge: one house of the kind built in 1918, with a tree beside it. -->
    <path d={houseTree.trunk} /><path d={houseTree.crown} />
    <rect x="240" y="64" width="14" height="44" />
    <rect x="90" y="170" width="220" height="130" />
    <polygon points="78,170 200,40 322,170" />
    <rect x="182" y="96" width="36" height="40" /><path d="M 200 96 V 136" />
    <rect x="114" y="196" width="46" height="50" /><path d="M 137 196 V 246 M 114 220 H 160" />
    <rect x="240" y="196" width="46" height="50" /><path d="M 263 196 V 246 M 240 220 H 286" />
    <rect x="186" y="226" width="28" height="74" />
    <path d={hedge(40, 172)} /><path d={hedge(228, 380)} />
    <path d="M 20 300 H 470" />
  </g>}
</svg>
