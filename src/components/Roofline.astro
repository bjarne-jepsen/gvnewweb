---
// A row of houses and trees drawn as one green line above the footer (docs/cvi.md § 5). It is decoration:
// aria-hidden, hidden in print. The line draws itself and starts over about every 12 seconds; with
// prefers-reduced-motion it just stands still. The drawing is made at build time from a fixed seed, so
// every page gets the same line and the output does not change between builds.
const W = 1320, H = 90;
let seed = 7;
const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
let x = 0, d = `M0 ${H}`, lastTree = true;
const n = (v: number) => Math.round(v * 10) / 10;
while (x < W) {
  if (!lastTree && rnd() < 0.22) { // a tree: trunk, crown, trunk down again
    d += ` L${x + 14} ${H} V${H - 20} A15 15 0 1 1 ${x + 22} ${H - 20} V${H}`; x += 36; lastTree = true; continue;
  }
  lastTree = false;
  const w = 48 + Math.round(rnd() * 24), roof = 24 + Math.round(rnd() * 8), wall = 30, eave = H - wall, slope = roof / (w / 2);
  d += ` L${x} ${H} V${eave} L${n(x + w / 2)} ${eave - roof}`;
  if (rnd() < 0.5) { // a chimney on the right-hand roof
    const c = x + w * 0.7, top = eave - roof + (c - x - w / 2) * slope;
    d += ` L${n(c)} ${n(top)} V${n(top - 11)} H${n(c + 7)} V${n(top + 7 * slope)}`;
  }
  d += ` L${x + w} ${eave} V${H}`;
  x += w;
}
d += ` H${W}`;
---
<div class="roofline wrap" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H + 1}`} preserveAspectRatio="xMidYMax slice" focusable="false"><path d={d} pathLength="1" /></svg>
</div>
