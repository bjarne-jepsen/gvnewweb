---
// Landing page of a section (docs/cvi.md § 5): one tile per page with a picture, the title and the summary.
// The picture is the first image in the document, cropped to 3:2. A page without images gets the placeholder.
interface Props { label: string; entries: { path: string; title: string; summary: string; image?: { src: string; alt: string } }[]; }
const { label, entries } = Astro.props;
---
{entries.length ? <ul class="tiles" aria-label={`Sider under ${label}`}>{entries.map(entry => <li>
  <div class="tile-picture">
    {entry.image ? <img src={entry.image.src} alt={entry.image.alt} loading="lazy" decoding="async" /> : <svg viewBox="0 0 300 200" aria-hidden="true" focusable="false">
      <rect width="300" height="200" fill="#E7EAE3" />
      <path d="M0 150h300v50H0z" fill="#D5DBCF" />
      <path d="M38 150v-46l34-30 34 30v46M106 150v-46l34-30 34 30v46M174 150v-46l34-30 34 30v46" fill="#F2F2EE" stroke="#4A5248" stroke-width="2" stroke-linejoin="round" />
      <path d="M30 111l42-37 42 37M98 111l42-37 42 37M166 111l42-37 42 37" fill="none" stroke="#4A5248" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M64 150v-22h16v22M132 150v-22h16v22M200 150v-22h16v22" fill="none" stroke="#4A5248" stroke-width="2" />
    </svg>}
  </div>
  <div class="tile-text">
    <h2><a href={entry.path}>{entry.title}</a></h2>
    {entry.summary && <p>{entry.summary}</p>}
  </div>
</li>)}</ul> : <p>Der er ingen offentliggjorte sider her endnu.</p>}
