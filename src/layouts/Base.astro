---
import { getCollection } from 'astro:content';
import { rssGuidePath, rssPath } from '../../lib/site/rss';
import '../styles/tokens.css';
import '../styles/site.css';
import Search from '../components/Search.astro';
import { NEW_TAB_HINT } from '../../lib/site/render';
interface Props { title: string; front?: boolean; }
const { title, front = false } = Astro.props;
const path = Astro.url.pathname;
const sections = (await getCollection('sections')).map(s => s.data).sort((a, b) => a.order - b.order);
// Each page section opens a panel with its pages; the landing page is the first link in the panel.
// The news section has no panel: its items come and go, and its landing page is the list.
const collator = new Intl.Collator('da-DK');
const pages = (await getCollection('items')).map(i => i.data).filter(i => i.kind === 'page').sort((a, b) => collator.compare(a.title, b.title));
const navigation = sections.map(s => ({ ...s, pages: s.news ? [] : pages.filter(p => p.section === s.key) }));
const current = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
const newsSections = sections.filter(s => s.news);
const footerLinks = [
  ...(await getCollection('links')).map(l => l.data).filter(l => l.group === 'footer').sort((a, b) => a.order - b.order),
  ...newsSections.map(s => ({ label: newsSections.length === 1 ? 'Abonnér på nyheder (RSS)' : `${s.label} (RSS)`, href: rssGuidePath(s), external: false })),
];
// The favicon is a house as a data URI, so it adds no file to the output. Colours are the ink, green and paper tokens.
const favicon = `data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><path d="M2 15 16 3l14 12z" fill="#141414"/><path d="M6 15h20v14H6z" fill="#1E4636"/><path d="M14 20h4v9h-4z" fill="#FFFFFF"/></svg>')}`;
---
<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="En lokal prototype med Grøndalsvænges offentlige information fra foreningens Google Drive." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    {newsSections.map(s => <link rel="alternate" type="application/rss+xml" title={`${s.label} · Grøndalsvænge`} href={rssPath(s)} />)}
    <title>{title} · Grøndalsvænge</title>
  </head>
  <body class:list={{ front }}>
    <a class="skip" href="#indhold">Spring til indhold</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-current={current('/') ? 'page' : undefined}><span class="brand-name">Andelsboligforeningen Grøndalsvænge</span></a>
        <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="hovedmenu" data-menu-toggle>
          <svg class="menu-icon menu-icon-open" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M2 5h16M2 10h16M2 15h16" /></svg>
          <svg class="menu-icon menu-icon-close" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="m4 4 12 12M16 4 4 16" /></svg>
          Menu
        </button>
        <nav aria-label="Hovednavigation" class="site-nav" id="hovedmenu">
          {navigation.map(s => s.pages.length === 0
            ? <a href={s.path} aria-current={current(s.path) ? 'page' : undefined}>{s.label}</a>
            : <details class="nav-group" data-nav-group>
                <summary class:list={{ 'is-current': current(s.path) }}>{s.label}</summary>
                <div class="nav-panel">
                  <a class="nav-landing" href={s.path} aria-current={path === s.path ? 'page' : undefined}>Gå til {s.label}</a>
                  <ul>{s.pages.map(p => <li><a href={p.path} aria-current={path === p.path ? 'page' : undefined}>{p.title}</a></li>)}</ul>
                </div>
              </details>)}
        </nav>
        <Search />
      </div>
    </header>
    <main id="indhold" class="wrap"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="footer-name">Grøndalsvænge</p>
        <div class="footer-grid">
          {footerLinks.length > 0 && <nav aria-labelledby="sidefod-genveje"><p class="footer-label" id="sidefod-genveje">Genveje</p><ul class="footer-links">{footerLinks.map(l => <li>{l.external ? <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}<span class="visually-hidden"> ({NEW_TAB_HINT})</span></a> : <a href={l.href}>{l.label}</a>}</li>)}</ul></nav>}
          <div class="wide"><p class="footer-label">For andelshavere</p><p>Dokumenter for andelshavere ligger i ProBo hos administrator.</p><p class="colophon">Lokal prototype: indholdet hentes fra hjemmesidens mapper i foreningens Google Drive.</p></div>
        </div>
      </div>
    </footer>
    <script>
      // Menu panels: one open at a time; Escape and a click outside close them. Without the script the
      // panels still open and close (they are <details>), they just stay open until clicked again.
      // Keep the width in step with site.css.
      const phone = matchMedia('(max-width: 59.99rem)');
      const groups = [...document.querySelectorAll<HTMLDetailsElement>('[data-nav-group]')];
      for (const g of groups) g.addEventListener('toggle', () => { if (g.open) for (const o of groups) if (o !== g) o.open = false; });
      document.addEventListener('click', e => { if (!phone.matches) for (const g of groups) if (g.open && !g.contains(e.target as Node)) g.open = false; });

      // Phones and small tablets: the menu folds into a "Menu" button and opens as a list under the name,
      // with the panels as sections that unfold in the list. Without JavaScript the button is hidden and
      // the menu is shown as on a large screen (site.css).
      const header = document.querySelector<HTMLElement>('.site-header')!;
      const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
      const nav = header.querySelector<HTMLElement>('.site-nav')!;
      const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
      const setMenu = (open: boolean) => {
        toggle.setAttribute('aria-expanded', String(open));
        header.classList.toggle('menu-open', open);
        if (!open) for (const g of groups) g.open = false;
      };
      header.classList.add('has-menu');
      toggle.addEventListener('click', () => setMenu(!isOpen()));
      phone.addEventListener('change', () => setMenu(false));

      document.addEventListener('keydown', e => {
        if (e.key !== 'Escape') return;
        const open = groups.find(g => g.open);
        if (open) { open.open = false; open.querySelector('summary')!.focus(); return; }
        // Escape in the open menu, or on the button, closes the menu and leaves the focus on the button.
        const at = document.activeElement;
        if (phone.matches && isOpen() && (at === toggle || nav.contains(at))) { setMenu(false); toggle.focus(); }
      });
    </script>
  </body>
</html>
