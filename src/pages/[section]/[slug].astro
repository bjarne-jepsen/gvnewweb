---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { date } from '../../../lib/site/sections';
export async function getStaticPaths() {
  const sections = new Map((await getCollection('sections')).map(s => [s.data.key, s.data]));
  return (await getCollection('items')).map(({ data: item }) => ({ params: { section: item.section, slug: item.slug }, props: { item, section: sections.get(item.section)! } }));
}
const { item, section } = Astro.props;
---
<Base title={item.title}>
  <a class="back" href={section.path}>Til {section.label.toLocaleLowerCase('da-DK')}</a>
  <article>
    <h1>{item.title}</h1>
    {item.kind === 'notice' && <p class="meta"><time datetime={item.date}>{date(item.date)}</time></p>}
    {(item.kind === 'page' || item.kind === 'notice') && <div class="prose" set:html={item.html} />}
    {item.kind === 'document' && <p><a class="download" href={item.download} download>Hent PDF · {Math.ceil(item.sizeBytes / 1024)} KB</a></p>}
    {item.kind !== 'notice' && <p class="meta">Opdateret {date(item.updatedAt)}</p>}
  </article>
</Base>
