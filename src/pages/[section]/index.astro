---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Entries from '../../components/Entries.astro';
export async function getStaticPaths() {
  const items = (await getCollection('items')).map(i => i.data);
  return (await getCollection('sections')).map(({ data: section }) => ({ params: { section: section.key }, props: { section, entries: items.filter(i => i.section === section.key) } }));
}
const { section, entries } = Astro.props;
// A news section shows its notices as cards (docs/cvi.md), other sections as a plain list.
const cards = entries.length > 0 && entries.every(e => e.kind === 'notice');
---
<Base title={section.label}>
  <a class="back" href="/">Til forsiden</a>
  <h1>{section.label}</h1>
  <p class="intro">{section.intro}</p>
  <Entries heading="h2" cards={cards} entries={entries} />
</Base>
