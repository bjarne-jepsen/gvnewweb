---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Entries from '../components/Entries.astro';
const sections = (await getCollection('sections')).map(s => s.data).sort((a, b) => a.order - b.order);
const items = (await getCollection('items')).map(i => i.data);
---
<Base title="Forside">
  <p class="prototype">Lokal prototype med indhold fra foreningens Google Drive</p>
  <h1>Information til livet i Grøndalsvænge</h1>
  <p class="intro">Find information om foreningen, praktiske vejledninger og dokumenter samlet ét sted.</p>
  {sections.map(s => <section aria-labelledby={`sektion-${s.key}`}>
    <h2 id={`sektion-${s.key}`}><a href={s.path}>{s.label}</a></h2>
    <Entries entries={items.filter(i => i.section === s.key)} />
  </section>)}
</Base>
